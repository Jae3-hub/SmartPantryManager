<?xml version="1.0" encoding="utf-8"?>

<!--card view is used to display individual suggested recipes-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="4dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@android:color/white">

        <!--recipe name-->
        <TextView
            android:id="@+id/textRecipeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#245C43"
            android:fontFamily="sans"
            android:layout_marginBottom="12dp"/>

        <!--heading for the ingredients list-->
        <TextView
            android:id="@+id/textIngredientsHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredients needed"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#2E7D52"
            android:layout_marginBottom="8dp"/>

        <!--required ingredients displayed underneath each other-->
        <TextView
            android:id="@+id/textRecipeIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Tomato\n• Onion\n• Potato"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:textColor="#43564A"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>