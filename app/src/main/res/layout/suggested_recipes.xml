<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="20dp"
    tools:context=".SuggestedRecipesActivity">

    <!--main heading-->
    <TextView
        android:id="@+id/textSuggestedTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Suggested Recipes"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#245C43"
        android:fontFamily="sans"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--subtitle explaining recipe matching-->
    <TextView
        android:id="@+id/textMatchingSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Discover delicious meals using ingredients in your pantry."
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:textColor="#65776B"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/textSuggestedTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--recycler view for matching recipes-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewSuggested"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/textMatchingSubtitle"
        app:layout_constraintBottom_toTopOf="@id/btnBackToPantry"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        tools:listitem="@layout/all_recipes"/>

    <!--empty state view when zero recipes match-->
    <TextView
        android:id="@+id/textEmptySuggestions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="No recipes match your pantry yet.\nTry adding more ingredients to discover meals you can make."
        android:textSize="15sp"
        android:lineSpacingExtra="5dp"
        android:textStyle="italic"
        android:textColor="#477A5C"
        android:gravity="center"
        android:background="#F0F7F1"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/textMatchingSubtitle"
        app:layout_constraintBottom_toTopOf="@id/btnBackToPantry"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--button to return to the pantry items page-->
    <Button
        android:id="@+id/btnBackToPantry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="54dp"
        android:layout_marginBottom="8dp"
        android:text="←  Back to My Pantry"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2E7D52"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>