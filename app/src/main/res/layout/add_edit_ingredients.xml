<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Pantry Ingredient"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginBottom="24dp"/>

    <!--ingredient name-->
    <EditText
        android:id="@+id/editIngredientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingredient Name (e.g., tomato)"
        android:inputType="TextPersonName"
        android:layout_marginBottom="16dp"/>

    <!--quantity-->
    <EditText
        android:id="@+id/editIngredientQty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quantity (e.g., 3)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="16dp"/>

    <!--unit-->
    <EditText
        android:id="@+id/editIngredientUnit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Unit (e.g., pieces, g, ml, tbsp)"
        android:inputType="text"
        android:layout_marginBottom="16dp"/>

    <!--expiry date-->
    <EditText
        android:id="@+id/editIngredientExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Expiry Date (Optional, e.g., 2026-11-01)"
        android:inputType="date"
        android:layout_marginBottom="24dp"/>

    <!--save button-->
    <Button
        android:id="@+id/btnSaveIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Changes"
        android:backgroundTint="@android:color/holo_green_dark"
        android:textColor="@android:color/white"/>

</LinearLayout>