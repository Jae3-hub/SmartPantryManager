<?xml version="1.0" encoding="utf-8"?>
<!-- this sets out how each pantry item will look-->

<!--card view wraps each row item to give it a clean look with a shadowed card appearance-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:layout_marginHorizontal="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!--left side: vertical layout for ingredient name and other info-->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textIngredientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingredient Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"/>

            <TextView
                android:id="@+id/textIngredientDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Qty: 0 unit | Expiry: None"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!--right side: delete button -->
        <Button
            android:id="@+id/btnDeletePantry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            style="?android:attr/buttonStyleSmall"
            android:textColor="@android:color/holo_red_dark"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>