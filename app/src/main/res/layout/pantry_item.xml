<?xml version="1.0" encoding="utf-8"?>

<!-- Card displaying an individual pantry item -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="4dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp">

    <!-- Main horizontal layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@android:color/white">

        <!-- Left side: ingredient name and details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/textIngredientName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingredient Name"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#245C43" />

            <TextView
                android:id="@+id/textIngredientDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Qty: 0 unit | Expiry: None"
                android:textSize="13sp"
                android:textColor="#65776B"
                android:layout_marginTop="5dp" />

        </LinearLayout>

        <!-- Right side: Edit and Delete buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="4dp">

            <Button
                android:id="@+id/btnEditPantry"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:text="Edit"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#245C43"
                android:backgroundTint="#DDEFE2" />

            <Button
                android:id="@+id/btnDeletePantry"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:text="Delete"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#245C43"
                android:backgroundTint="#DDEFE2" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
